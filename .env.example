# Primary provider: openai | vllm | ollama
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Used when LLM_PROVIDER is vllm or ollama.
# vLLM normally runs on a GPU server; Ollama is recommended for CPU laptops.
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# CPU-local embeddings and vector store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_PATH=./data/chroma_db

# Server
APP_HOST=0.0.0.0
APP_PORT=8000

# Retry settings
MAX_RETRIES=3
RETRY_BACKOFF_BASE=1.0
RETRY_MAX_WAIT=10.0

# Rate limiting and response cache
RATE_LIMIT_PER_MINUTE=30
CACHE_MAX_SIZE=256
CACHE_TTL_SECONDS=300

# Optional fallback provider. Ollama is recommended on CPU-only laptops.
FALLBACK_PROVIDER=ollama
FALLBACK_VLLM_BASE_URL=http://localhost:11434/v1
FALLBACK_VLLM_MODEL=llama3.2:3b

# Generation and retrieval
TEMPERATURE=0.2
TOP_P=0.9
TOP_K=5
MAX_TOOL_ROUNDS=3
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_TOKENS=800
REQUEST_TIMEOUT_SECONDS=120
MAX_CONCURRENT_LLM_CALLS=1

# Optional Redis cache. Leave empty to use the local in-memory cache.
REDIS_URL=
